from operator import itemgetter

# Create a list of numbers from 0 to 9.
data = list(range(10))

# Slice examples:
# data[2:7] -> elements from index 2 up to 6
# data[::2] -> every 2nd element
# data[::-1] -> reverse the list
# data[-3:] -> last 3 elements
print(data[2:7], data[::2], data[::-1], data[-3:])

# Replace 3 items (indexes 2, 3, 4) with only 2 items: "a" and "b"
data[2:5] = ["a", "b"]  # replace three items with two
print(data)

# A list of (name, age) pairs.
people = [("Ana", 31), ("Bilal", 25), ("Chen", 31), ("Dina", 22)]

# Sort by age in ascending order (second item in each tuple)
print(sorted(people, key=lambda p: p[1]))

# Sort by age in descending order, and if ages are equal, sort by name ascending
# (-p[1] makes larger ages come first, then p[0] breaks ties alphabetically)
print(sorted(people, key=lambda p: (-p[1], p[0])))  # age desc, then name

# Same as sorting by age descending, but using itemgetter from operator module
print(sorted(people, key=itemgetter(1), reverse=True))

# Words with mixed capitalization.
words = ["banana", "Apple", "cherry"]

# sorted(words) sorts in default ASCII/lexicographic order,
# which may place uppercase letters before lowercase ones.
print(sorted(words))

# sorted(words, key=str.lower) ignores case and sorts alphabetically by lowercase version.
print(sorted(words, key=str.lower))